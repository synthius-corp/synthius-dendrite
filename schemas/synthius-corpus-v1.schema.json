{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthius.ai/schemas/synthius-corpus-v1.schema.json",
  "title": "Synthius corpus record v1",
  "description": "One newline-delimited record emitted by a reviewed Dendrite parser.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ts", "user", "uid", "text", "type", "source", "reference_metadata"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "ts": { "type": ["string", "null"], "maxLength": 128 },
    "user": { "type": "string", "minLength": 1, "maxLength": 500 },
    "uid": { "type": "string", "maxLength": 500 },
    "text": { "type": "string", "minLength": 1, "maxLength": 250000 },
    "type": { "type": "string", "maxLength": 120 },
    "source": { "type": "string", "maxLength": 120 },
    "reference_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "record", "text_sha256"],
      "properties": {
        "version": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "record": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "original_id": { "type": "string", "maxLength": 500 },
        "chat_name": { "type": "string", "maxLength": 500 },
        "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "char_start": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "char_end": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "line_start": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "line_end": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "page_start": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "page_end": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "paragraph_start": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "paragraph_end": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    }
  }
}
